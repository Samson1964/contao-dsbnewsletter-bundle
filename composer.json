{
    "name": "schachbulle/contao-dsbnewsletter-bundle",
    "type": "contao-bundle",
    "description": "Erweitert den Contao-Newsletter um frei sortierbare Inhaltselemente mit Überschrift, Bild und Text, wie sie der Deutsche Schachbund für seinen Newsletter benötigt.",
    "keywords": [
        "contao",
        "newsletter",
        "dsb",
        "inhaltselemente",
        "nachrichten"
    ],
    "homepage": "https://github.com/Samson1964/contao-dsbnewsletter-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.7"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoDsbnewsletterBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoDsbnewsletterBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-dsbnewsletter-bundle/issues",
        "source": "https://github.com/Samson1964/contao-dsbnewsletter-bundle"
    }
}
